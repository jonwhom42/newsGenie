# ──────────────────────────────────────────────────────────────
# NewsGenie configuration — copy this file to `.env` and fill in.
#   cp .env.example .env        (macOS/Linux)
#   Copy-Item .env.example .env (Windows PowerShell)
# ──────────────────────────────────────────────────────────────

# REQUIRED — Google AI Studio API key (the chatbot/LLM, free tier).
# Get one (free, no card) at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# REQUIRED for live news — NewsAPI.org key (free tier: 100 req/day).
# Get one at https://newsapi.org/register
# If this is missing, NewsGenie still runs and falls back to web search.
NEWSAPI_KEY=

# OPTIONAL — which Gemini model to use.
# Default is gemini-2.5-flash (fast, free tier). Alternatives:
#   gemini-2.0-flash   (also free, slightly older)
#   gemini-2.5-pro     (stronger, lower free-tier limits)
GEMINI_MODEL=gemini-2.5-flash

# OPTIONAL — default country for top-headlines (ISO 3166-1 code).
# Examples: us, gb, in, au, ca. NewsAPI top-headlines is country-scoped.
NEWS_COUNTRY=us
